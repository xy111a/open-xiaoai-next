# 复制成 .env 再填。密钥不要提交进仓库。
# NAS 内网 IP（Hub 与音箱、HA 之间用这个地址通信）
# 2026-11-19：NAS 的 LAN IP 是 192.168.88.247（不是旧的 192.168.1.10）。
NAS_IP=192.168.88.247

# Hub 监听端口，部署时定（默认 4399=停老 Hub 直接接管；其它值如 4400=与老 Hub 并行）。
# nas-install.sh 会按这个值改 config.yaml 的 listen；音箱端 client.toml 的 hub_url
# 端口也要改成同一个值。HUB_PORT 不填时 nas-install.sh 默认 4399。
HUB_PORT=4399

# 音乐文件夹（可选本地兜底，NAS 上的路径，默认 /volume1/Music）。
# 不填则用默认 /volume1/Music；路径不存在只警告，不阻塞启动；
# 网易云直连是主路，本地歌只是降级。（注意：music_folder 为空仍是配置错误，
# 但经 compose 的默认值兜底，Hub 收到的一定是非空路径。）
# 2026-11-19：音乐在 /volume1/Music（/volume1/music 不存在，大小写敏感）。
MUSIC_FOLDER=/volume1/Music

# 2026-11-18 音乐融合 B：Music Assistant 已砍，MA_TOKEN 已废弃，不用填。
# 如旧 .env 里曾手动加过 MA_TOKEN，请删掉那一行（Hub 不再读它；
# 注意：本模板与 compose 从未传过 MA_TOKEN，Hub 的 MA 路径实际一直未启用）。

# 音箱 IP（OH2P，如 192.168.88.190；preflight 的音箱可达性检查用）。
# 不填时 preflight 跳过音箱检查、不阻塞部署；填了但连不上时 preflight 失败。
SPEAKER_IP=

# Home Assistant 长期访问令牌（HA → 个人资料 → 长期访问令牌）
HASS_TOKEN=

# LLM 密钥（DeepSeek 或 Qwen，按 hub/config.yaml 里 agents 的 model 填）
LLM_API_KEY=

# Client→Hub 鉴权 Token（与音箱端 client.toml 的 token 一致）
OPEN_XIAOAI_TOKEN=CHANGE_ME

# Web 面板 /api/* 的 Bearer Token（FW-P1-1，与 OPEN_XIAOAI_TOKEN 独立，必填）
# 未填或太弱时：nas-install.sh 预检查拒绝部署；即使绕过，Hub 也以空 Token 启动、/api/* 一律 401。
# 生成一个与 OPEN_XIAOAI_TOKEN 不同的强随机值：openssl rand -hex 16
OPEN_XIAOAI_WEB_TOKEN=CHANGE_ME
