# 复制成 .env 再填。密钥不要提交进仓库。
# NAS 内网 IP（Hub 与音箱、HA 之间用这个地址通信）
NAS_IP=192.168.1.10

# 音乐文件夹（NAS 上的路径，默认 /volume1/music）
MUSIC_FOLDER=/volume1/music

# Home Assistant 长期访问令牌（HA → 个人资料 → 长期访问令牌）
HASS_TOKEN=

# LLM 密钥（DeepSeek 或 Qwen，按 hub/config.yaml 里 agents 的 model 填）
LLM_API_KEY=

# Client→Hub 鉴权 Token（与音箱端 client.toml 的 token 一致）
OPEN_XIAOAI_TOKEN=CHANGE_ME
